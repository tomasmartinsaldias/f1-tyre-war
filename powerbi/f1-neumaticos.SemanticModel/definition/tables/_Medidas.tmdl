table _Medidas
	lineageTag: f109edcd-bc73-46bb-b6b2-98d97f815e1b

	measure 'Mediana Gap Pole Pct' =
			
			DIVIDE(
			    CALCULATE(
			        MEDIAN('formula1 v_f1_qualy_granular'[pct_gap_to_pole]),
			        'formula1 v_f1_qualy_granular'[is_within_107] = TRUE()
			    ),
			    100
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 5340a3b0-b39a-4c31-95db-9e0effbb5de5

	measure 'Total Puntos' = SUM('formula1 v_f1_race_granular'[points])
		lineageTag: 7d2aa055-b1dd-46c5-99d9-557181e1da19

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Posicion Llegada' =
			
			CALCULATE(
			    AVERAGE('formula1 v_f1_race_granular'[finish_position]),
			    'formula1 v_f1_race_granular'[is_finished] = TRUE()
			)
		formatString: 0.00
		lineageTag: 1f05b90b-404e-401a-85b7-ea5b0a242749

	measure 'Tyre Failures per 1k Laps' =
			
			DIVIDE(
			    SUM('formula1 v_analisis_fiabilidad_neumaticos'[tyre_dnfs]),
			    SUM('formula1 v_analisis_fiabilidad_neumaticos'[total_laps_completed])
			) * 1000
		lineageTag: b272e92b-ec68-4ff7-aad3-486220be700d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Tyre to Accident Ratio' =
			
			DIVIDE(
			    SUM('formula1 v_analisis_fiabilidad_neumaticos'[tyre_dnfs]),
			    SUM('formula1 v_analisis_fiabilidad_neumaticos'[accident_dnfs])
			)
		lineageTag: e3128af6-9083-4959-8340-502bc1745f5e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Share Puntos Pct' =
			
			DIVIDE(
			    SUM('formula1 v_analisis_rendimiento_anual'[total_points]),
			    CALCULATE(
			        SUM('formula1 v_analisis_rendimiento_anual'[total_points]),
			        ALL('formula1 v_analisis_rendimiento_anual'[tyre_manufacturer_id])
			    )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 70b088f0-55c6-4b84-8c57-32d394308268

	measure Texto_Insight_Dinamico = ```
			
			VAR SegmentoSeleccionado = SELECTEDVALUE('dim_segmento_estrategico'[id_segmento], "todos")
			RETURN
			    SWITCH(
			        SegmentoSeleccionado,
			        "top_tier", 
			        "COLAPSO EN LA CIMA (TOP TIER):" & UNICHAR(10) &
			        "Tras dominar 2001-2004 con brechas al suelo (<0.50%), Ferrari colapsó en 2005 al 1.60% por degradación térmica sin paradas. Michelin (Renault y McLaren) capitalizó el cambio reglamentario cayendo por debajo del 0.50% a la pole.",
			        
			        "midfield", 
			        "ÉXODO Y DISPARADA EN MIDFIELD:" & UNICHAR(10) &
			        "Michelin optimizó su rendimiento de forma continua hacia el 1.60%. En contrapartida, los clientes de Bridgestone se descolgaron al 2.70% en 2004 antes de abandonar el compuesto o quedar desiertos en 2005.",
			        
			        "backmarker", 
			        "FONDO DE GRILLA (SUPERVIVENCIA):" & UNICHAR(10) &
			        "Entre 2003 y 2005 Bridgestone se estancó en brechas superiores al 5.00%. En contraste, los equipos de fondo calzados con Michelin mostraron un salto de eficiencia notable en 2005, reduciendo la brecha al 2.50%.",
			        
			        /* Texto Global sin botón seleccionado */
			        "PANORAMA ESTRATÉGICO GLOBAL:" & UNICHAR(10) &
			        "En 2005, la prohibición de cambios de neumáticos invirtió la jerarquía técnica. Bridgestone perdió competitividad estructural en todos los estratos de la grilla." & UNICHAR(10) & UNICHAR(10) &
			        "INSTRUCCIÓN: Seleccione un segmento en la cabecera (Top Tier, Midfield o Fondo) para auditar el comportamiento de cada estrato."
			    )
			```
		lineageTag: a543c48c-d150-45cd-adec-5d3428a931f7

	measure Puntos_Segmento_Filtrado = SUM('formula1 v_analisis_rendimiento_anual'[total_points])
		lineageTag: 297bd041-4314-4eb8-b971-71fa1aff7c30

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Lluvia Delta Promedio Seg' = AVERAGE('formula1 v_analisis_rendimiento_lluvia_carreras'[diferencia_sec])
		formatString: +0.000;-0.000;0.000
		lineageTag: a1c834b2-9df1-4a34-b209-ee7c00192801

	measure 'Lluvia Pct Gap Promedio' =
			
			DIVIDE(
			    AVERAGE('formula1 v_analisis_rendimiento_lluvia_carreras'[pct_diferencia]),
			    100
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b3d945c1-1ef2-4b45-a310-ff8d11293902

	measure 'Lluvia Victorias Michelin' =
			
			CALCULATE(
			    COUNTROWS('formula1 v_analisis_rendimiento_lluvia_carreras'),
			    'formula1 v_analisis_rendimiento_lluvia_carreras'[proveedor_mas_rapido] = "michelin"
			)
		formatString: 0
		lineageTag: c4e056d2-2fa3-4c56-b421-aa9e22304003

	measure 'Lluvia Victorias Bridgestone' =
			
			CALCULATE(
			    COUNTROWS('formula1 v_analisis_rendimiento_lluvia_carreras'),
			    'formula1 v_analisis_rendimiento_lluvia_carreras'[proveedor_mas_rapido] = "bridgestone"
			)
		formatString: 0
		lineageTag: d5f167e3-3ab4-4d67-c532-bbaf33415114

	measure 'Lluvia Veredicto Dinamico' =
			
			VAR SelSegmento = SELECTEDVALUE(dim_segmento_estrategico[id_segmento], "todos")
			RETURN
			    SWITCH(
			        SelSegmento,
			        "top_tier", "Top Tier: Paridad técnica cerrada (+0.12s Bridgestone histórico, pero Michelin dominó 2005)",
			        "midfield", "Midfield: Michelin domina ampliamente (-0.80s / -0.89% delta, 10 victorias vs 3)",
			        "backmarker", "Fondo de Grilla: Ventaja marginal de Bridgestone (+0.97s) en supervivencia",
			        "General: La ventaja de Bridgestone en lluvia fue exclusiva de Ferrari; en la clase media Michelin fue 0.8s más veloz"
			    )
		lineageTag: e6a278f4-4bc5-4e78-d643-ccba44526225

	measure 'Titulo Dinamico Rendimiento Lluvia' =
			
			VAR SelSegmento = SELECTEDVALUE(dim_segmento_estrategico[nombre_arquetipo], "Todos los Segmentos")
			VAR Veredicto = [Lluvia Veredicto Dinamico]
			RETURN
			    "Rendimiento en Lluvia - " & SelSegmento & " | " & Veredicto
		lineageTag: f7b38905-5cd6-4f89-e754-ddcb55637336

	partition _Medidas = m
		mode: import
		source =
				let
				    Origen = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Columna1 = _t]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(Origen,{{"Columna1", type text}}),
				    #"Columnas quitadas" = Table.RemoveColumns(#"Tipo cambiado",{"Columna1"})
				in
				    #"Columnas quitadas"

	annotation PBI_ResultType = Table
